  "repo_path": "/home/keith/projects/TradingAgents",
  "index_path": "/home/keith/projects/TradingAgents/.codelearner/index.db",
  "commit_note": "Hand-written against TradingAgents @ 58 indexed files, 255 symbols (.codelearner/index.db, 2026-08-02). Smallest of the three repos and the terse-docstring extreme: most docstrings are a single sentence restating the name ('Determine if debate should continue.'), which is the opposite of swarm-sync and the harder case for dense retrieval.",
  "labelling_rule": "Relevant = a symbol a competent engineer would want to READ to answer the question. Tests are listed only where the question is about behaviour under test. Implementations are listed even when tests describe them better, because the question asks how the code works.",
  "authoring_rule": "Every query is phrased from what the code DOES, in a newcomer's domain words, NOT by echoing the target's identifiers. Drafted from the source, then measured for token overlap against the target's chunk text (the exact text BM25 indexes) and against the target's own symbol name; queries whose wording leaked a target identifier are flagged name_bearing so they can be scored as a separate row instead of silently inflating the lexical modality.",
  "repo_note": "The dominant structure here is the closure: `create_<role>` returns a `<role>_node` function, so the behaviour a question is about lives in a NESTED function whose name the caller never writes. That shape is a large share of the private/undocumented coverage below and is exactly what commit-prose mining cannot name.",
  "overlap_method": {
    "tokenizer": "lowercase, split on non-alphanumeric and camelCase boundaries, drop <3 chars, drop a 100-word English stoplist",
    "corpus": "chunks.text for every symbol in this repo's index (the field chunks_fts indexes, i.e. exactly what BM25 scores)",
    "name_overlap": "fraction of distinct query tokens that appear in some relevant symbol's OWN name (symbols.name / last dotted component)",
    "source_overlap": "fraction of distinct query tokens that appear in some relevant symbol's chunk text",
    "rare_source_overlap": "fraction of distinct query tokens that appear in a relevant symbol's chunk text AND have document frequency <= 2% of chunks -- the high-IDF terms BM25 actually ranks on",
    "idf_weighted_source_overlap": "sum of idf over query tokens present in a relevant chunk, divided by sum of idf over all query tokens",
    "name_bearing": "true iff name_overlap > 0, i.e. the query names the target. Not automatically wrong (real users do sometimes know the name) but must be scored as its own row."
  },
  "coverage_codes": {
    "undocumented": "target symbol has no docstring in the index",
    "private": "target is a _-prefixed helper, a nested function, or a dunder",
    "generic_name": "target's name is generic or misleading (get_llm, invoke, main, node) so the name carries no query signal",
    "cross_module": "answering requires reading symbols in 2+ modules",
    "error_path": "the question is about a failure, edge case, or refusal rather than the happy path",
    "hard_negative": "the obvious keyword match in this repo is the WRONG symbol; a lexical-only retriever is actively penalised"
  },
